# SportEdge Pro — production environment template.
# Copy to `.env.prod` on the VPS and fill in real secrets:
#   cp .env.prod.example .env.prod
#   nano .env.prod
# Then bring the stack up:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# .env.prod must NEVER be committed to git.

# --- Public hostname + ACME -----------------------------------------------
# Caddy obtains and renews a Let's Encrypt cert for this hostname.
# Requires a DNS A record pointing PUBLIC_DOMAIN at the VPS IP, with
# host ports 80 and 443 reachable from the internet.
PUBLIC_DOMAIN=sportedge.mauriziomolinari.cloud
# Email Let's Encrypt notifies if a renewal fails or the cert is about
# to expire. Use a real mailbox you read.
ACME_EMAIL=maurizio@mauriziomolinari.cloud

# --- Database (no host port — internal docker network only) ---------------
POSTGRES_DB=sportedge
POSTGRES_USER=sportedge
# Generate with:  openssl rand -base64 32
POSTGRES_PASSWORD=replace-with-strong-secret

# --- Auth -----------------------------------------------------------------
# Generate with:  openssl rand -hex 48
JWT_SECRET_KEY=replace-with-openssl-rand-hex-48
JWT_ACCESS_TOKEN_TTL_MINUTES=120
JWT_REFRESH_TOKEN_TTL_DAYS=14

# --- Default user (seeded on first migration) -----------------------------
# Use whichever email you'd like to log in with — the seeded row will be
# created on first boot and never touched again unless you reset the DB.
DEFAULT_USER_EMAIL=maurizio@mauriziomolinari.cloud
DEFAULT_USER_PASSWORD=replace-on-first-login
DEFAULT_STARTING_BANKROLL=1000.00

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO

# --- Frontend build-time API base ----------------------------------------
# Default keeps /api/v1 same-origin (Caddy proxies it to backend). Override
# only if the API lives on a different host than the frontend.
VITE_API_BASE_URL=/api/v1

# --- Obsidian vault (host path that gets mounted to /vault) --------------
# Recommended on a self-hosted VPS:
#   - point at a Syncthing folder (host ↔ laptop) so notes round-trip
#   - or an iCloud/OneDrive synced folder
OBSIDIAN_VAULT_PATH=/srv/sportedge/obsidian-vault
