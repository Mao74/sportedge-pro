# SportEdge Pro — environment template.
# Copy to `.env` and fill in real secrets. Never commit `.env`.

# --- Runtime ---
APP_ENV=dev                    # dev | test | prod
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sportedge
POSTGRES_USER=sportedge
POSTGRES_PASSWORD=change-me-strong

# --- Auth (used from step 5 onwards) ---
# Generate a fresh secret with:  python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET_KEY=replace-with-openssl-rand-hex-48
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=120
JWT_REFRESH_TOKEN_TTL_DAYS=14

# --- Default user (seeded by the post-init migration in step 2) ---
DEFAULT_USER_EMAIL=you@domain.tld
DEFAULT_USER_PASSWORD=change-on-first-login
DEFAULT_STARTING_BANKROLL=1000.00

# --- Betfair ---
BETFAIR_DEFAULT_COMMISSION_PCT=5.00

# --- Obsidian (step 14b) ---
OBSIDIAN_DEFAULT_VAULT=/vault
OBSIDIAN_VAULT_PATH=./obsidian-vault    # host path mounted into the container

# --- Frontend ---
VITE_API_BASE_URL=/api/v1
