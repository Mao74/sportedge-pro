{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"],
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "dist-types"
  },
  "include": ["vite.config.ts", "tailwind.config.ts", "postcss.config.js"]
}
